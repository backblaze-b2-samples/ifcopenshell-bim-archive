# Backblaze B2 (required) — S3-compatible API. Create an application key and a
# bucket at https://www.backblaze.com/cloud-storage then fill these in.
B2_APPLICATION_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
# Region of your bucket, e.g. us-west-004, us-east-005, eu-central-003. The S3
# endpoint is derived from it (https://s3.<region>.backblazeb2.com), so you set
# the region, not a URL.
B2_REGION=your_region

# Optional. Public base URL for a PUBLIC bucket, used to build direct object
# URLs (e.g. https://<bucket>.s3.<region>.backblazeb2.com or a CDN origin). The
# app runs without it — object serving falls back to short-lived presigned URLs.
# B2_PUBLIC_URL_BASE=https://your-bucket.s3.us-west-004.backblazeb2.com

# Example of what filled-in values look like (fake — for visual reference only):
# B2_APPLICATION_KEY_ID=00abcdef1234567000000001
# B2_APPLICATION_KEY=K001exampleexampleexampleexampleexa
# B2_BUCKET_NAME=my-bim-archive
# B2_REGION=us-west-004

# Frontend → API base URL. Defaults to http://localhost:8000 for local dev;
# set this to the deployed API origin in production (Next.js inlines it at
# build time, so it must be present when `pnpm build` runs).
# NEXT_PUBLIC_API_URL=https://your-api.example.com
